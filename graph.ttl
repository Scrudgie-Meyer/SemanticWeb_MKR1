@prefix ex: <http://example.org/mkr/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Airline a rdfs:Class .

ex:BudgetFlight a rdfs:Class ;
    rdfs:subClassOf ex:Flight .

ex:City a rdfs:Class .

ex:Country a rdfs:Class .

ex:Flight a rdfs:Class .

ex:LongFlight a rdfs:Class ;
    rdfs:subClassOf ex:Flight .

ex:arrivesAt a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range ex:City .

ex:departsFrom a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range ex:City .

ex:departureDate a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range xsd:date .

ex:durationMin a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range xsd:integer .

<http://example.org/mkr/flight/FL-1494> a ex:LongFlight ;
    ex:arrivesAt <http://example.org/mkr/city/Madrid> ;
    ex:departsFrom <http://example.org/mkr/city/Berlin> ;
    ex:departureDate "2026-08-14"^^xsd:date ;
    ex:durationMin 204 ;
    ex:fromBusyCountry true ;
    ex:operatedBy <http://example.org/mkr/airline/Blue_Meridian> ;
    ex:priceEur 110.50 .

<http://example.org/mkr/flight/FL-3280> a ex:Flight ;
    ex:arrivesAt <http://example.org/mkr/city/Vilnius> ;
    ex:departsFrom <http://example.org/mkr/city/Prague> ;
    ex:departureDate "2026-08-27"^^xsd:date ;
    ex:durationMin 130 ;
    ex:operatedBy <http://example.org/mkr/airline/AeroVista> ;
    ex:priceEur 209.00 .

<http://example.org/mkr/flight/FL-3816> a ex:LongFlight ;
    ex:arrivesAt <http://example.org/mkr/city/Munich> ;
    ex:departsFrom <http://example.org/mkr/city/Oslo> ;
    ex:departureDate "2026-08-12"^^xsd:date ;
    ex:durationMin 216 ;
    ex:operatedBy <http://example.org/mkr/airline/Falcon_Jet> ;
    ex:priceEur 186.50 .

<http://example.org/mkr/flight/FL-5843> a ex:Flight ;
    ex:arrivesAt <http://example.org/mkr/city/Odesa> ;
    ex:departsFrom <http://example.org/mkr/city/Munich> ;
    ex:departureDate "2026-03-18"^^xsd:date ;
    ex:durationMin 95 ;
    ex:fromBusyCountry true ;
    ex:operatedBy <http://example.org/mkr/airline/Lumen_Air> ;
    ex:priceEur 179.99 .

<http://example.org/mkr/flight/FL-7056> a ex:BudgetFlight,
        ex:LongFlight ;
    ex:arrivesAt <http://example.org/mkr/city/Vilnius> ;
    ex:departsFrom <http://example.org/mkr/city/Vienna> ;
