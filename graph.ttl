    ex:durationMin 251 ;
    ex:fromBusyCountry true ;
    ex:operatedBy <http://example.org/mkr/airline/AeroVista> ;
    ex:priceEur 78.00 .

<http://example.org/mkr/flight/FL-7909> a ex:Flight ;
    ex:arrivesAt <http://example.org/mkr/city/Lviv> ;
    ex:departsFrom <http://example.org/mkr/city/Berlin> ;
    ex:departureDate "2026-06-25"^^xsd:date ;
    ex:durationMin 87 ;
    ex:fromBusyCountry true ;
    ex:operatedBy <http://example.org/mkr/airline/Orbit_Airways> ;
    ex:priceEur 248.00 .

<http://example.org/mkr/flight/FL-8712> a ex:BudgetFlight,
        ex:LongFlight ;
    ex:arrivesAt <http://example.org/mkr/city/Lyon> ;
    ex:departsFrom <http://example.org/mkr/city/Madrid> ;
    ex:departureDate "2026-03-11"^^xsd:date ;
    ex:durationMin 273 ;
    ex:operatedBy <http://example.org/mkr/airline/TransCarpa> ;
    ex:priceEur 76.99 .

<http://example.org/mkr/flight/FL-9077> a ex:Flight ;
    ex:arrivesAt <http://example.org/mkr/city/Prague> ;
    ex:departsFrom <http://example.org/mkr/city/Paris> ;
    ex:departureDate "2026-07-05"^^xsd:date ;
    ex:durationMin 84 ;
    ex:operatedBy <http://example.org/mkr/airline/SkyNord> ;
    ex:priceEur 138.00 .

<http://example.org/mkr/flight/FL-9163> a ex:BudgetFlight,
        ex:LongFlight ;
    ex:arrivesAt <http://example.org/mkr/city/Lviv> ;
    ex:departsFrom <http://example.org/mkr/city/Milan> ;
    ex:departureDate "2026-07-21"^^xsd:date ;
    ex:durationMin 238 ;
    ex:fromBusyCountry true ;
    ex:operatedBy <http://example.org/mkr/airline/Falcon_Jet> ;
    ex:priceEur 54.00 .

<http://example.org/mkr/flight/FL-9723> a ex:LongFlight ;
    ex:arrivesAt <http://example.org/mkr/city/Lyon> ;
    ex:departsFrom <http://example.org/mkr/city/Vienna> ;
    ex:departureDate "2026-03-08"^^xsd:date ;
    ex:durationMin 224 ;
    ex:fromBusyCountry true ;
    ex:operatedBy <http://example.org/mkr/airline/Zephyr_Lines> ;
    ex:priceEur 167.50 .

ex:fromBusyCountry a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range xsd:boolean .

ex:locatedIn a rdf:Property ;
    rdfs:domain ex:City ;
    rdfs:range ex:Country .

ex:operatedBy a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range ex:Airline .

ex:priceEur a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range xsd:decimal .

ex:reportedBy a rdf:Property ;
    rdfs:domain rdf:Statement ;
    rdfs:range rdfs:Resource .

<http://example.org/mkr/stmt/FL-2404-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/PassengerReport> ;
    rdf:object 15 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-2404> .

<http://example.org/mkr/stmt/FL-2520-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/AirWatch> ;
    rdf:object 55 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-2520> .

<http://example.org/mkr/stmt/FL-4906-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/AirWatch> ;
    rdf:object 25 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-4906> .

<http://example.org/mkr/stmt/FL-6025-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/AirWatch> ;
    rdf:object 40 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-6025> .

<http://example.org/mkr/stmt/FL-7819-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/AirWatch> ;
    rdf:object 90 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-7819> .

<http://example.org/mkr/stmt/FL-9520-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/FlightLog> ;
    rdf:object 55 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-9520> .

